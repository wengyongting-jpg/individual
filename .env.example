# PE6201 Grounded Enterprise Policy & Procedure Assistant
# Foundation Model configuration — COPY this file to ".env" and fill in your key.
# The real ".env" is git-ignored and must NEVER be committed.

# Your OpenRouter API key (https://openrouter.ai/keys). Leave blank to run the
# project offline (the model step is then reported as PENDING_EXECUTION).
OPENROUTER_API_KEY=

# Model slug (provider/model). Examples:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-haiku
#   meta-llama/llama-3.1-8b-instruct
MODEL_NAME=openai/gpt-4o-mini

# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_TEMPERATURE=0
